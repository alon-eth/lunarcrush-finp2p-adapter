# Data mode. Own key (Builder tier or above) = production, direct to LunarCrush, no cap.
# Empty = trial tier through DGB's gateway (demo and testing, metered per Router org, see /health).
# LUNARCRUSH_MODE=fixture forces deterministic fixtures with no network at all.
LUNARCRUSH_API_KEY=
LUNARCRUSH_MODE=
LUNARCRUSH_TRIAL_GATEWAY=https://lc-trial-gateway.alon-d6b.workers.dev
# Router ingest endpoint. Ownera will supply the real Router URL; the path is /data/assets/ingest.
ROUTER_INGEST_URL=http://localhost:4101/data/assets/ingest
# Router auth. Ownera issues ROUTER_ORG_ID + ROUTER_API_KEY against the public key from `npm run keygen`.
# ROUTER_AUTH: jwt (RS256 one-time token, 30s; the only scheme the ingest path accepts) | none
#   none = connector mode (installed inside a Router, ROUTER_INGEST_URL=http://finp2p-node/data/assets/ingest)
#          or a test Router with auth off. `legacy` is kept for inspection only; Routers reject it.
ROUTER_AUTH=jwt
ROUTER_ORG_ID=
ROUTER_API_KEY=
ROUTER_PRIVATE_KEY_FILE=keys/private.pem
# or inline: ROUTER_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n..."
# schemaRef stamped on socialSentiment items (PR open on owneraio/finp2p-certificates-spec)
SCHEMA_REF=https://ownera.io/certificates/data/socialSentiment.schema.json
PORT=4100
REFRESH_SECONDS=3600
# Where subscriptions are persisted so a restart resumes them (fix 4). Mount this path in connector mode.
SUBSCRIPTIONS_FILE=data/subscriptions.json
